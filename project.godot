; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot My Farm"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.7")

[audio]

default_bus_layout="res://default_bus_layout.tres"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
DataCatalog="*res://scripts/autoload/data_catalog.gd"
ItemManager="*res://scripts/autoload/item_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
MapManager="*res://scripts/autoload/map_manager.gd"
CalendarManager="*res://scripts/autoload/calendar_manager.gd"
EffectManager="*res://scripts/autoload/effect_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Dialogic="*uid://ds2q0uclmolvu"
InteractManager="*res://scripts/autoload/interact_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"bed_sleep_confirmation": "res://data/dialogue/bed_sleep_confirmation.dtl",
"npc_fisher_default": "res://data/dialogue/npc_fisher_default.dtl",
"npc_ranger_default": "res://data/dialogue/npc_ranger_default.dtl",
"npc_villager_default": "res://data/dialogue/npc_villager_default.dtl",
"television_report": "res://data/dialogue/television_report.dtl"
}
layout/style_directory={}
text/input_action="interact"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/dialogic/plugin.cfg")

