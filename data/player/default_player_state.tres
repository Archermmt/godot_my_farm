[gd_resource type="Resource" script_class="PlayerState" format=3]

[ext_resource type="Script" path="res://scripts/state/player_state.gd" id="1_player"]
[ext_resource type="Script" path="res://scripts/state/inventory/backpack_state.gd" id="2_backpack"]
[ext_resource type="Script" path="res://scripts/state/inventory/backpack_slot.gd" id="3_slot"]

[sub_resource type="Resource" id="ParsnipSeed"]
script = ExtResource("3_slot")
slot_id = &"itembar_0"
item_id = &"seed_parsnip"
amount = 15

[sub_resource type="Resource" id="PumpkinSeed"]
script = ExtResource("3_slot")
slot_id = &"itembar_1"
item_id = &"seed_pumpkin"
amount = 10

[sub_resource type="Resource" id="PotatoSeed"]
script = ExtResource("3_slot")
slot_id = &"itembar_2"
item_id = &"seed_potato"
amount = 10

[sub_resource type="Resource" id="Hoe"]
script = ExtResource("3_slot")
slot_id = &"toolbar_0"
item_id = &"tool_hoe"
amount = 1

[sub_resource type="Resource" id="WateringCan"]
script = ExtResource("3_slot")
slot_id = &"toolbar_1"
item_id = &"tool_watering_can"
amount = 1

[sub_resource type="Resource" id="Sickle"]
script = ExtResource("3_slot")
slot_id = &"toolbar_2"
item_id = &"tool_sickle"
amount = 1

[sub_resource type="Resource" id="Basket"]
script = ExtResource("3_slot")
slot_id = &"toolbar_3"
item_id = &"tool_basket"
amount = 1

[sub_resource type="Resource" id="Pickaxe"]
script = ExtResource("3_slot")
slot_id = &"toolbar_4"
item_id = &"tool_pickaxe"
amount = 1

[sub_resource type="Resource" id="Axe"]
script = ExtResource("3_slot")
slot_id = &"toolbar_5"
item_id = &"tool_axe"
amount = 1

[sub_resource type="Resource" id="Backpack"]
script = ExtResource("2_backpack")
slots = {
&"itembar_0": SubResource("ParsnipSeed"),
&"itembar_1": SubResource("PumpkinSeed"),
&"itembar_2": SubResource("PotatoSeed"),
&"toolbar_0": SubResource("Hoe"),
&"toolbar_1": SubResource("WateringCan"),
&"toolbar_2": SubResource("Sickle"),
&"toolbar_3": SubResource("Basket"),
&"toolbar_4": SubResource("Pickaxe"),
&"toolbar_5": SubResource("Axe")
}
toolbar = Array[StringName]([&"toolbar_0", &"toolbar_1", &"toolbar_2", &"toolbar_3", &"toolbar_4", &"toolbar_5"])
itembar = Array[StringName]([&"itembar_0", &"itembar_1", &"itembar_2", &"itembar_3", &"itembar_4", &"itembar_5", &"itembar_6", &"itembar_7", &"itembar_8", &"itembar_9"])
inventory_capacity = 20
selected_toolbar_index = 0
selected_itembar_index = 0

[resource]
script = ExtResource("1_player")
backpack_state = SubResource("Backpack")
