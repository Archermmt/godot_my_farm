[sub_resource type="Resource" id="ScheduleVillager"]
script = ExtResource("9_schedule")
id = &"schedule_villager"
npc_id = &"npc_villager"
fallback_map_id = &"cabin"
fallback_cell = Vector2i(5, 4)
events = Array[ExtResource("8_event")]([SubResource("ScheduleEventFarm")])

[resource]
script = ExtResource("1_catalog")
items = Array[ExtResource("2_item")]([SubResource("ItemHoe"), SubResource("ItemWateringCan"), SubResource("ItemSickle"), SubResource("ItemBasket"), SubResource("ItemPickaxe"), SubResource("ItemAxe"), SubResource("ItemSeedParsnip"), SubResource("ItemParsnip"), SubResource("ItemWood"), SubResource("ItemStone"), SubResource("ItemGrass"), SubResource("ItemFood"), SubResource("HarvestTree"), SubResource("HarvestRock"), SubResource("HarvestGrass")])
drop_tables = Array[ExtResource("6_table")]([SubResource("DropParsnip"), SubResource("DropWood"), SubResource("DropStone"), SubResource("DropGrass")])
npc_schedules = Array[ExtResource("9_schedule")]([SubResource("ScheduleVillager")])
