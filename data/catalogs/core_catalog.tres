[sub_resource type="Resource" id="ItemParsnip"]
script = ExtResource("4_plant")
id = &"crop_parsnip"
display_name = "Parsnip"
description = "A crisp spring root."
item_type = 3
use_kind = 5
stack_limit = 99
buy_price = 50
sell_price = 35
seed_item_id = &"seed_parsnip"
stages = Array[Dictionary]([{
"drop_table_id": &"",
"max_health": 1,
"start_day": 0,
"state_tags": Array[StringName]([&"sprout"]),
"visual_key": &"parsnip_seed"
}, {
"drop_table_id": &"",
"max_health": 1,
"start_day": 2,
"state_tags": Array[StringName]([&"growing"]),
"visual_key": &"parsnip_sprout"
}, {
"drop_table_id": &"",
"max_health": 2,
"start_day": 4,
"state_tags": Array[StringName]([&"growing"]),
"visual_key": &"parsnip_leaves"
}, {
"drop_table_id": &"drop_parsnip",
"max_health": 2,
"start_day": 6,
"state_tags": Array[StringName]([&"mature", &"harvestable"]),
"visual_key": &"parsnip_mature"
}])
requires_water = true
required_tool = 4
max_health = 2
drop_table_id = &"drop_parsnip"
blocks_movement = false
state_tags = Array[StringName]([&"plant"])

