[sub_resource type="Resource" id="Resource_dialogue_rowan_line_0"]
script = ExtResource("29_dialogue_line")
speaker_id = &"npc_ranger"
speaker_name = "Rowan"
text = "The trail bends around the hills. Watch your footing near the narrow paths."

[sub_resource type="Resource" id="Resource_dialogue_rowan_line_1"]
script = ExtResource("29_dialogue_line")
speaker_id = &"npc_ranger"
speaker_name = "Rowan"
text = "I patrol the field each day, so I may know what has changed out here."

