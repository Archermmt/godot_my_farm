[sub_resource type="Resource" id="Resource_dialogue_mina_line_0"]
script = ExtResource("29_dialogue_line")
speaker_id = &"npc_villager"
speaker_name = "Mina"
text = "The paths are quiet today. It is a good time to explore."

[sub_resource type="Resource" id="Resource_dialogue_mina_line_1"]
script = ExtResource("29_dialogue_line")
speaker_id = &"npc_villager"
speaker_name = "Mina"
