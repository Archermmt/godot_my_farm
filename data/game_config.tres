speaker_id = &"npc_fisher"
speaker_name = "Tao"
text = "The coast is calm. I saw silver fish near the rocks this morning."

[sub_resource type="Resource" id="Resource_dialogue_tao_line_1"]
script = ExtResource("29_dialogue_line")
speaker_id = &"npc_fisher"
speaker_name = "Tao"
text = "Keep an eye on the weather when you travel between maps."

